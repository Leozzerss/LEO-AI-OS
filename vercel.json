{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/jarvis_web/static/:path*"
    },
    {
      "source": "/manifest.json",
      "destination": "/jarvis_web/static/manifest.json"
    },
    {
      "source": "/icon.png",
      "destination": "/jarvis_web/static/icon.png"
    }
  ]
}
